{
  "name": "midnightway",
  "version": "1.1.0",
  "description": "Yet another astal-based wayland bar, dock, and panels",
  "keywords": [
    "astal",
    "wayland"
  ],
  "license": "MIT",
  "author": "nenw <khi@nenw.dev>",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "pnpm build:renderer && pnpm build:shell",
    "build:renderer": "vite build",
    "build:shell": "vite build --mode shell",
    "dev": "pnpm build && LD_PRELOAD=\"$EXTERN_GTK4_LAYER_SHELL\" GSK_RENDERER=ngl gjs -m dist/index.js",
    "dev:inspect": "pnpm dev --inspect",
    "generate": "pnpm run generate:clean && pnpm run generate:gir && pnpm run generate:i18n",
    "generate:clean": "rm -rf src/definitions/girs",
    "generate:gir": "ts-for-gir generate --outdir src/definitions/girs --ignoreVersionConflicts '*'",
    "generate:i18n": "simplei18n generate",
    "format": "oxfmt",
    "lint": "oxlint",
    "postinstall": "pnpm run generate",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/hash": "^0.9.2",
    "@emotion/react": "^11.14.0",
    "@react-spring/web": "^10.0.0",
    "@simplei18n/core": "^0.1.4",
    "ags": "extern:ags",
    "date-fns": "^4.1.0",
    "dompurify": "^3.2.3",
    "es-toolkit": "^1.31.0",
    "lucide-react": "^0.474.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "stylis": "^4.3.4",
    "ts-pattern": "^5.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@styled/typescript-styled-plugin": "^1.0.1",
    "@ts-for-gir/cli": "4.9.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.6",
    "@types/react-dom": "^19.0.3",
    "@types/stylis": "^4.2.7",
    "csstype": "^3.1.3",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-svgr": "^5.2.0"
  },
  "packageManager": "pnpm@10.15.0"
}
