Fix ownership of menu attribute variants before exposing them to GMenuModel
consumers. A hash table does not sink floating references; GJS can consume
those references and later free variants still owned by the menu.

--- a/item.c
+++ b/item.c
@@ -101,4 +101,4 @@
 				g_hash_table_insert(item->attrs,
 				                    g_strdup(G_MENU_ATTRIBUTE_SUBMENU_ACTION),
-				                    g_variant_new_string(name));
+				                    g_variant_ref_sink(g_variant_new_string(name)));
 				action_creator_found = true;
@@ -117,4 +117,4 @@
 				g_hash_table_insert(item->attrs,
 				                    g_strdup(G_MENU_ATTRIBUTE_ACTION),
-				                    g_variant_new_string(name));
